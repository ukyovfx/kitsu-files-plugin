# Do not put production credentials here. init.ps1 creates an ACL-protected
# local file under %LOCALAPPDATA% and fills it with per-UAT synthetic secrets.
VFX_FILES_UAT_PROJECT=vfx-files-uat-example
VFX_FILES_UAT_SOURCE_SHORT=replace-with-source-short-sha
VFX_FILES_UAT_SOURCE_HEAD=replace-with-source-commit
VFX_FILES_UAT_BACKEND_SUBNET=172.31.240.0/24
VFX_FILES_UAT_INGRESS_SUBNET=172.31.241.0/24
VFX_FILES_UAT_CANDIDATE_IMAGE=replace-with-built-candidate-image
VFX_FILES_UAT_DB_PASSWORD=generate-with-init-script
VFX_FILES_UAT_REDIS_PASSWORD=generate-with-init-script
VFX_FILES_UAT_SECRET_KEY=generate-with-init-script
VFX_FILES_UAT_TEST_PASSWORD=generate-with-init-script
VFX_FILES_UAT_HTTP_PORT=55280
VFX_FILES_ENABLED=false
VFX_FILES_WORKER_ENABLED=false
