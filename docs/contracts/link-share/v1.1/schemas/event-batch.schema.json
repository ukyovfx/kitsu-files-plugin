{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ukyovfx:vfx-files:contracts:1.1:event-batch",
  "title": "Draft VFX Files event batch 1.1",
  "description": "Draft 1.1 envelope. The separate KitsuSync 1.0 batch contract remains unchanged; this schema accepts only 1.1 events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "events"
  ],
  "properties": {
    "contract_version": {
      "const": "1.1"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "urn:ukyovfx:vfx-files:contracts:1.1:file-share-created"
      }
    }
  }
}
