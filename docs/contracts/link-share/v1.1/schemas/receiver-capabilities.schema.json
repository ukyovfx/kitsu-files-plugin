{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vfx-files/contracts/1.1/receiver-capabilities.schema.json",
  "title": "Draft receiver capabilities 1.1 response",
  "description": "Proposal only. Must be authenticated, fresh, and bound to the intended Production before use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_versions",
    "event_types",
    "max_batch_events",
    "production_id",
    "expires_at"
  ],
  "properties": {
    "contract_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "1.0",
          "1.1"
        ]
      }
    },
    "event_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "max_batch_events": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "production_id": {
      "type": "string",
      "format": "uuid"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    }
  }
}
